# Copy this file to .env and fill in values as needed.
# Nothing here is required to run the platform -- all defaults work out of the box.

ENVIRONMENT=development
DEBUG=true

# SQLite by default (zero config). For Postgres in production:
# DATABASE_URL=postgresql+asyncpg://researchos:researchos@postgres:5432/researchos
DATABASE_URL=sqlite+aiosqlite:///./data/researchos.db

PDF_STORAGE_DIR=./data/pdfs

# --- Discovery sources ---
# Semantic Scholar works keyless at a lower rate limit; add a key to raise it.
# SEMANTIC_SCHOLAR_API_KEY=

# --- Rate limiting (always on; tune per deployment) ---
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PER_SECOND=2.0

# --- Auth (off by default) ---
# Flip on to require a Bearer token (see scripts/issue_token.py) on
# paper-ingest / knowledge-extract / research-run calls. Leave both unset
# to run with no auth, which is the default and fully functional.
REQUIRE_API_AUTH=false
# API_AUTH_SECRET=generate-a-long-random-string-here

# --- Optional: add this later to upgrade extraction quality ---
# Without a key: heuristic (regex/keyword) extraction runs, which works
# well for common paper structures. With a key: the LLM extraction and
# survey-writing paths take over automatically, with the heuristic path
# as an automatic fallback if any single call fails.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: distributed tracing (off by default, zero overhead) ---
# Point at any OTLP-compatible collector (Jaeger, Grafana Tempo, etc).
# See observability/README.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
